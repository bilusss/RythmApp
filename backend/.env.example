PORT=3001
HOST=127.0.0.1           # keep localhost; public access goes through infra/cloudflared
SUPABASE_URL=            # TODO: from Supabase project settings -> API
SUPABASE_SERVICE_KEY=    # TODO: service_role key (server only, never ship to the app)
BIELIK_BASE_URL=http://127.0.0.1:8000/v1   # backend on the GPU PC; via Tailscale: http://pc-gpu:8000/v1
BIELIK_API_KEY=                  # same as infra/vllm/.env
BIELIK_MODEL=bielik             # --served-model-name in infra/vllm/docker-compose.yml
LLM_TIMEOUT=120000      # ms
